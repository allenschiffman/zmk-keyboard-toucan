#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

/* Layer Definitions */
#define BASE_L  0
#define NAV_L   1
#define SYM_L   2
#define ADJ_L   3
#define IOS_L   4
#define GAME_L  5
#define IOS_NAV 6

/ {
    /* urob's Timeless Home Row Mods Configuration */
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    /* Combos / Chords for fast typing triggers */
    combos {
        compatible = "zmk,combos";
        
        /* Pressing D + F together sends Escape */
        combo_esc {
            timeout-ms = <50>;
            key-positions = <15 16>; // D and F keys
            bindings = <&kp ESC>;
        };

        /* Pressing J + K together sends Backspace */
        combo_bspc {
            timeout-ms = <50>;
            key-positions = <19 20>; // J and K keys
            bindings = <&kp BSPC>;
        };
    };

    /* Custom Macros for iOS Spotlight Automation */
    macros {
        /* Macro to launch Spotlight, type "Open Keymap" Shortcut, and hit Enter */
        open_keymap: open_keymap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp LGUI>
                , <&macro_wait_time 100>
                , <&macro_tap &kp O &kp P &kp E &kp N &kp SPACE &kp K &kp E &kp Y &kp M &kp A &kp P>
                , <&macro_wait_time 100>
                , <&macro_tap &kp RET>
                ;
        };
    };

    /* Symmetrical Tri-Layer Activation */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        
        /* Holding NAV (Layer 1) and SYM (Layer 2) on Windows Base Layer triggers ADJ (Layer 3) */
        tri_layer_base {
            if-layers = <1 2>;
            then-layer = <3>;
        };

        /* Holding INAV (Layer 6) and SYM (Layer 2) on iOS Base Layer triggers ADJ (Layer 3) */
        tri_layer_ios {
            if-layers = <6 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: BASE */
        default_layer {
            bindings = <
&kp TAB    &kp Q       &kp W       &kp E        &kp R        &kp T          &kp Y       &kp U        &kp I        &kp O       &kp P          &kp BSPC
&kp LCTRL  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F  &kp G          &kp H       &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V        &kp B          &kp N       &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp ESC
                                   &kp LGUI     &mo NAV_L    &kp SPC        &kp RET     &mo SYM_L    &kp LALT
            >;
        };

        /* Layer 1: NAV */
        nav_layer {
            bindings = <
&kp TAB    &kp N1      &kp N2      &kp N3       &kp N4       &kp N5         &kp N6      &kp N7       &kp N8       &kp N9      &kp N0         &kp BSPC
&bt BT_CLR &bt BT_SEL 0&bt BT_SEL 1&bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT    &kp DOWN     &kp UP       &kp RIGHT   &none          &none
&kp LSHFT  &studio_unlock &none    &none        &none        &none          &none       &none        &none        &none       &none          &none
                                   &kp LGUI     &trans       &kp SPC        &kp RET     &trans       &kp LALT
            >;
        };

        /* Layer 2: SYM */
        sym_layer {
            bindings = <
&kp TAB    &kp EXCL    &kp AT      &kp HASH     &kp DLLR     &kp PRCNT      &kp CARET   &kp AMPS     &kp ASTRK    &kp LPAR    &kp RPAR       &kp BSPC
&kp LCTRL  &none       &none       &none        &none        &none          &kp MINUS   &kp EQUAL    &kp LBKT     &kp RBKT    &kp BSLH       &kp GRAVE
&kp LSHFT  &none       &none       &none        &none        &none          &kp UNDER   &kp PLUS     &kp LBRC     &kp RBRC    &kp PIPE       &kp TILDE
                                   &kp LGUI     &trans       &kp SPC        &kp RET     &trans       &kp LALT
            >;
        };

        /* Layer 3: ADJ */
        adj_layer {
            bindings = <
&to BASE_L &none       &kp F7      &kp F8       &kp F9       &kp F12        &kp C_VOL_DN&kp C_MUTE   &kp C_VOL_UP &none       &none          &kp BSPC
&kp LCTRL  &none       &kp F4      &kp F5       &kp F6       &kp F11        &to GAME_L  &to IOS_L    &to BASE_L   &none       &none          &none
&bt BT_NXT &none       &kp F1      &kp F2       &kp F3       &kp F10        &none       &none        &none        &none       &none          &none
                                   &kp LGUI     &trans       &kp SPC        &kp RET     &trans       &kp LALT
            >;
        };

        /* Layer 4: IOS */
        ios_layer {
            bindings = <
&kp TAB    &kp Q       &kp W       &kp E        &kp R        &kp T          &kp Y       &kp U        &kp I        &kp O       &kp P          &kp BSPC
&kp LGUI   &hm LCTRL A &hm LALT S  &hm LGUI D   &hm LSHFT F  &kp G          &kp H       &hm RSHFT J  &hm RGUI K   &hm RALT L  &hm RCTRL SEMI &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V        &kp B          &kp N       &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp ESC
                                   &kp LCTRL    &mo IOS_NAV  &kp SPC        &kp RET     &mo SYM_L    &kp LALT
            >;
        };

        /* Layer 5: GAME (Unified Gaming, Media & Discord controls) */
        game_layer {
            bindings = <
&kp steam://open/bigpicture &kp LA(SPACE) &kp LG(LC(O)) &kp C_PP &kp C_NEXT &kp C_PREV   &kp LA(Z)   &kp LA(F10)  &kp LA(LS(F10)) &kp LA(F1) &kp LA(F12)  &kp LA(F4)
&kp LCTRL  &kp LG(EQUAL) &kp LG(MINUS) &kp LG(ESC)  &kp LC(LS(M)) &kp LC(LS(D))   &kp LG(G)   &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE  &mkp RCLK      &kp LC(LS(ESC))
&kp LSHFT  &kp LC(Z)   &kp LC(X)   &kp LC(C)    &kp LC(V)    &kp LALT       &none       &none        &kp LG(N2)   &kp LG(N4)  &kp LG(N3)     &kp LG(N1)
                                   &kp LGUI     &none        &kp SPC        &to BASE_L  &none        &none
            >;
        };

        /* Layer 6: IOS_NAV (iPadOS Stage Manager, window snapping & overlays) */
        ios_nav_layer {
            bindings = <
&kp TAB    &kp N1      &kp N2      &kp N3       &kp N4       &kp N5         &open_keymap &kp LG(S)    &kp C_PP    &kp C_NEXT  &kp C_PREV     &kp BSPC
&kp LCTRL  &kp LEFT    &kp DOWN    &kp UP       &kp RIGHT    &kp ESC        &kp LG(LA(F))&kp LC(LG(LEFT))&kp LC(LG(RIGHT))&kp LG(GRAVE)&kp LG(BSLH) &kp LG(Q)
&kp LSHFT  &kp LG(Z)   &kp LG(X)   &kp LG(C)    &kp LG(V)    &kp LG(LS(Z))  &kp LG(H)   &kp LG(UP)   &kp LG(C)   &kp LG(N)   &kp LG(LEFT)   &kp LG(RIGHT)
                                   &kp LGUI     &trans       &kp SPC        &to BASE_L  &none        &none
            >;
        };
    };
};
