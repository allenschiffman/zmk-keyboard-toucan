#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE    0
#define NAV     1
#define SYM     2
#define ADJ     3
#define IOS     4
#define GAME    5
#define G_SHIFT 6

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        // Launches Steam Big Picture: Win+R -> wait 100ms -> write URI -> Enter
        steam_bp: steam_big_picture {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp R>
                , <&macro_release &kp LGUI>
                , <&macro_wait_time 100>
                , <&macro_tap &kp S &kp T &kp E &kp A &kp M &kp COLON &kp FSLH &kp FSLH &kp O &kp P &kp E &kp N &kp FSLH &kp B &kp I &kp G &kp P &kp I &kp C &kp T &kp U &kp R &kp E>
                , <&macro_wait_time 10>
                , <&macro_tap &kp RET>;
        };

        // Win11 Display Switch (Extend): Win+R -> wait 50ms -> "DisplaySwitch 3" -> Enter
        disp_ext: display_extend {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp R>
                , <&macro_release &kp LGUI>
                , <&macro_wait_time 50>
                , <&macro_tap &kp D &kp I &kp S &kp P &kp L &kp A &kp Y &kp S &kp W &kp I &kp T &kp C &kp H &kp SPACE &kp N3>
                , <&macro_wait_time 10>
                , <&macro_tap &kp RET>;
        };

        // Win11 Display Switch (External Only): Win+R -> wait 50ms -> "DisplaySwitch 4" -> Enter
        disp_ext_only: display_external_only {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp R>
                , <&macro_release &kp LGUI>
                , <&macro_wait_time 50>
                , <&macro_tap &kp D &kp I &kp S &kp P &kp L &kp A &kp Y &kp S &kp W &kp I &kp T &kp C &kp H &kp SPACE &kp N4>
                , <&macro_wait_time 10>
                , <&macro_tap &kp RET>;
        };
    };
};

/* Intercept trackpad deltas and transform them to scroll events when on Layer 6 */
&msc_input_listener {
    input-processors = <&zip_temp_layer 6 2000>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Base Layer (Standard Typist Deck)
        base {
            display-name = "BASE";
            bindings = <
                // Left Half
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T
                &kp LCTRL &kp A  &kp S  &kp D  &kp F  &kp G
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B
                &kp LGUI  &mo 1  &kp SPACE
                
                // Right Half
                &kp Y     &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp H     &kp J  &kp K  &kp L  &kp SEMI &kp SQT
                &kp N     &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                &kp RET   &mo 2  &kp RALT
            >;
        };

        // Layer 1: Navigation Layer (Includes Bluetooth Controls & Studio Unlock)
        nav {
            display-name = "NAV";
            bindings = <
                // Left Half
                &kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &kp LSHFT   &studio_unlock &trans        &trans        &trans        &trans
                &kp LGUI    &trans        &kp SPACE
                
                // Right Half
                &kp N6    &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
                &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans     &trans
                &trans    &trans     &trans     &trans     &trans     &trans
                &kp RET   &trans     &kp RALT
            >;
        };

        // Layer 2: Symbols Layer
        sym {
            display-name = "SYM";
            bindings = <
                // Left Half
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT
                &kp LCTRL &trans   &trans &trans   &trans   &trans
                &kp LSHFT &trans   &trans &trans   &trans   &trans
                &kp LGUI  &trans   &kp SPACE
                
                // Right Half
                &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                &kp RET   &trans    &kp RALT
            >;
        };

        // Layer 3: Adjust Layer (Triggers when holding NAV + SYM)
        // Key 'H' (Col 1, Row 2) triggers GAME (Layer 5)
        // Key 'J' (Col 2, Row 2) triggers IOS (Layer 4)
        // Key 'K' (Col 3, Row 2) returns to BASE (Layer 0)
        adj {
            display-name = "ADJ";
            bindings = <
                // Left Half (TAB & LSHFT syntax bugs fully resolved here)
                &mo BASE  &trans &kp F7 &kp F8 &kp F9 &kp F12
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11
                &bt BT_NXT &trans &kp F1 &kp F2 &kp F3 &kp F10
                &kp LGUI  &mo 1  &kp SPACE
                
                // Right Half
                &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &trans     &trans     &kp BSPC
                &to GAME     &to IOS    &to BASE     &trans     &trans     &trans
                &trans       &trans     &trans       &trans     &trans     &trans
                &kp RET      &mo 2      &kp RALT
            >;
        };

        // Layer 4: Hardcoded iOS Layer (Command and Control Swapped)
        ios {
            display-name = "IOS";
            bindings = <
                // Left Half
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T
                &kp LGUI  &kp A  &kp S  &kp D  &kp F  &kp G
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B
                &kp LCTRL &mo 1  &kp SPACE
                
                // Right Half
                &kp Y     &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp H     &kp J  &kp K  &kp L  &kp SEMI &kp SQT
                &kp N     &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                &kp RET   &mo 2  &kp RALT
            >;
        };

        // Layer 5: Primary Gaming Overlay
        game {
            display-name = "GAME";
            bindings = <
                // Left Half (Kept transparent so your hand remains in standard WASD/movement position)
                &trans    &trans     &trans     &trans     &trans     &trans
                &trans    &trans     &trans     &trans     &trans     &trans
                &trans    &trans     &trans     &trans     &trans     &trans
                &trans    &trans     &trans
                
                // Right Half (Optimized One-Handed Controller Navigation Matrix)
                &kp LA(Z)     &kp LA(F10)   &kp LA(LS(F10))  &kp LA(F1)  &kp LA(F12)  &kp LA(F4)
                &kp LG(G)     &kp C_VOL_DN  &kp C_VOL_UP     &kp C_MUTE  &mkp RCLK    &kp LC(LS(ESC))
                &disp_ext     &disp_ext_only &kp LG(N2)      &kp LG(N4)  &kp LG(N3)   &kp LG(N1)
                &to BASE      &kp LG(D)     &mo G_SHIFT
            >;
        };

        // Layer 6: Shifted Gaming Overlay & Trackpad Scroll Interception
        // Holding down the T3 thumb key converts trackpad motion into vertical/horizontal scroll inputs.
        game_shift {
            display-name = "G_SHIFT";
            bindings = <
                // Left Half
                &trans    &trans     &trans     &trans     &trans     &trans
                &trans    &trans     &trans     &trans     &trans     &trans
                &trans    &trans     &trans     &trans     &trans     &trans
                &trans    &trans     &trans
                
                // Right Half (Couch Play, Toolbox, Voice, & Media Adjustments)
                &kp LC(LS(I))  &kp LG(LC(O))  &kp C_PP    &kp C_NEXT  &kp C_PREV  &steam_bp
                &kp LG(EQUAL)  &kp LG(MINUS)  &kp LG(ESC) &kp LC(LS(M)) &kp LC(LS(D)) &kp LA(TAB)
                &trans         &trans         &trans      &trans      &trans      &kp LA(SPACE)
                &to BASE       &trans         &trans
            >;
        };

        // Layers 7, 8, & 9: Virtual Reserved Layers for ZMK Studio Compatibility
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
